{
  "name": "Testes_Android",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.30.0",
    "@wdio/appium-service": "^9.30.0",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "appium-uiautomator2-driver": "^8.1.0"
  },
  "scripts": {
    "test": "wdio run ./config/wdio.conf.js",
    "report": "allure generate allure-results --clean -o allure-report",
    "login:report":"npm run test --suite login && npm run report",
    "form:report":"npm run test --suite form && npm run report",
    "scroll:report":"npm run test --suite scroll && npm run report"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
